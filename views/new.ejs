<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Нове оголошення</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <main class="container narrow">
    <a class="back-link" href="/">← На головну</a>

    <section class="form-card">
      <h1>Створити оголошення</h1>
      <p class="muted">Заповніть форму, щоб опублікувати нове оголошення.</p>

      <form action="/announcements" method="POST" novalidate>
        <fieldset class="form-group">
          <legend>Категорія</legend>

          <label class="radio-card">
            <input
              type="radio"
              name="category"
              value="sale"
              required
              <%= data?.category === 'sale' ? 'checked' : '' %>
            >
            📦 Продаж
          </label>

          <label class="radio-card">
            <input
              type="radio"
              name="category"
              value="service"
              <%= data?.category === 'service' ? 'checked' : '' %>
            >
            🔧 Послуги
          </label>

          <label class="radio-card">
            <input
              type="radio"
              name="category"
              value="job"
              <%= data?.category === 'job' ? 'checked' : '' %>
            >
            💼 Робота
          </label>

          <label class="radio-card">
            <input
              type="radio"
              name="category"
              value="other"
              <%= data?.category === 'other' ? 'checked' : '' %>
            >
            📌 Інше
          </label>

          <% if (errors.category) { %>
            <span class="error"><%= errors.category %></span>
          <% } %>
        </fieldset>

        <div class="form-group">
          <label for="title">Назва</label>
          <input
            id="title"
            type="text"
            name="title"
            placeholder="Коротка назва оголошення"
            required
            minlength="5"
            maxlength="100"
            value="<%= data?.title || '' %>"
          >
          <% if (errors.title) { %>
            <span class="error"><%= errors.title %></span>
          <% } %>
        </div>

        <div class="form-group">
          <label for="description">Опис</label>
          <textarea
            id="description"
            name="description"
            rows="6"
            placeholder="Детальний опис оголошення..."
            required
            minlength="10"
          ><%= data?.description || '' %></textarea>
          <% if (errors.description) { %>
            <span class="error"><%= errors.description %></span>
          <% } %>
        </div>

        <div class="form-group">
          <label for="price">Ціна</label>
          <input
            id="price"
            type="number"
            name="price"
            min="0"
            step="0.01"
            required
            value="<%= data?.price || '' %>"
          >
          <% if (errors.price) { %>
            <span class="error"><%= errors.price %></span>
          <% } %>
        </div>

        <div class="form-group">
          <label for="contactInfo">Контактна інформація</label>
          <input
            id="contactInfo"
            type="text"
            name="contactInfo"
            placeholder="Email або телефон"
            required
            minlength="5"
            value="<%= data?.contactInfo || '' %>"
          >
          <% if (errors.contactInfo) { %>
            <span class="error"><%= errors.contactInfo %></span>
          <% } %>
        </div>

        <div class="actions">
          <button class="btn primary" type="submit">Опублікувати</button>
          <a class="btn ghost" href="/">Скасувати</a>
        </div>
      </form>
    </section>
  </main>
</body>
</html>
